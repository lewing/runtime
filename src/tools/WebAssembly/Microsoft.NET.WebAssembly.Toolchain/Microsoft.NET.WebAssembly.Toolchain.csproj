<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Managed WebAssembly toolchain: binary reader/writer, validator, static linker (wasm-ld subset)
    and WAT compiler/disassembler. Shared by the wasm-link tool and the WasmLink MSBuild task.
  -->
  <PropertyGroup>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wasm-link" />
    <InternalsVisibleTo Include="Microsoft.NET.WebAssembly.Toolchain.Tests" />
  </ItemGroup>

</Project>
