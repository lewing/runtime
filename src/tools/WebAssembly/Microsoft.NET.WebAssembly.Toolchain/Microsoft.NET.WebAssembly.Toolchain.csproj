<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Managed WebAssembly toolchain: binary reader/writer, validator, static linker (wasm-ld subset)
    and WAT compiler/disassembler. Shared by the wasm-link tool and the WasmLink MSBuild task.
  -->
  <PropertyGroup>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Most sources are vendored from nesm and re-synced with sync-nesm.sh. Suppress style and
         performance-suggestion rules nesm doesn't enforce yet (Blazor-Playground/nesm#571) rather than
         carrying the fixes in runtime-local.patch, which would conflict on every sync. -->
    <NoWarn>$(NoWarn);CA1859;SA1136</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="wasm-link" />
    <InternalsVisibleTo Include="Microsoft.NET.WebAssembly.Toolchain.Tests" />
  </ItemGroup>

</Project>
