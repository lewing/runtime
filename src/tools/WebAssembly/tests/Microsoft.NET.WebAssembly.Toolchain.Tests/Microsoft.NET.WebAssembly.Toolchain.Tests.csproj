<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.XUnitExtensions" Version="$(MicrosoftDotNetXUnitExtensionsVersion)" />
    <ProjectReference Include="..\..\Microsoft.NET.WebAssembly.Toolchain\Microsoft.NET.WebAssembly.Toolchain.csproj" />
    <!-- The in-proc WasmLink MSBuild task that wraps the linker. -->
    <ProjectReference Include="$(RepoTasksDir)WasmBuildTasks\WasmBuildTasks.csproj" />
    <PackageReference Include="Microsoft.Build.Framework" Version="$(MicrosoftBuildFrameworkVersion)" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="$(MicrosoftBuildUtilitiesCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- wasm-ld parity tests use the wasi-sdk and wasm-tools from the shared wasm tool cache when present. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Microsoft.NET.WebAssembly.Toolchain.Tests.WasiSdkPath" Value="$(WasiSdkCacheDir)" />
    <RuntimeHostConfigurationOption Include="Microsoft.NET.WebAssembly.Toolchain.Tests.WasmToolsPath" Value="$(WasmToolsCacheDir)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\**\*.wat;TestAssets\**\*.wasm" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="TestAssets\hello.wasm" LogicalName="hello.wasm" />
    <EmbeddedResource Include="TestAssets\calculator.wasm" LogicalName="calculator.wasm" />
    <EmbeddedResource Include="TestAssets\sorting.wasm" LogicalName="sorting.wasm" />
    <EmbeddedResource Include="TestAssets\dwarf\add_probe_O0.wasm" LogicalName="dwarf/add_probe_O0.wasm" />
    <EmbeddedResource Include="TestAssets\dwarf\add_probe_O1.wasm" LogicalName="dwarf/add_probe_O1.wasm" />
    <EmbeddedResource Include="TestAssets\dwarf\sq_O0.wasm" LogicalName="dwarf/sq_O0.wasm" />
    <EmbeddedResource Include="TestAssets\dwarf\sq_O0_dwarf5_noname.wasm" LogicalName="dwarf/sq_O0_dwarf5_noname.wasm" />
    <EmbeddedResource Include="TestAssets\dwarf\sq_O1_wasmopt.wasm" LogicalName="dwarf/sq_O1_wasmopt.wasm" />
  </ItemGroup>

</Project>
